# MoodRx environment variables (copy to .env — never commit .env)

# CatDoes Watch error tracking
EXPO_PUBLIC_CATDOES_WATCH_KEY=

# RevenueCat public SDK keys (Project Settings → API keys → SDK API keys)
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# RevenueCat admin (scripts/seedRevenueCat.ts only — not needed in mobile builds)
REVENUECAT_PROJECT_ID=
REVENUECAT_TEST_STORE_APP_ID=
REVENUECAT_APPLE_APP_STORE_APP_ID=
REVENUECAT_GOOGLE_PLAY_STORE_APP_ID=

# Claude key for offline dev scripts (scripts/eval-vent.ts, scripts/insult-library/generate.ts)
MOODRX_COACH_KEY=

# ElevenLabs TTS (scripts/insult-library/voice.ts only — never in mobile builds)
ELEVENLABS_API_KEY=
